        expected = [App.Vector(wp.position), wp.position + 5*wp.u + 5*wp.v,
                    wp.position + 10*wp.u]
        arc_start(False)
        wire_points(((0, 0, 0), (5, 5, 0), (5, -5, 0)))
        check_arc(doc.Objects[0], expected)

