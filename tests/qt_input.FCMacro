    def intersection_snap(doc):
        import Draft
        import DraftTools
        Draft.make_line(App.Vector(-20, 4, 0), App.Vector(20, 4, 0))
        Draft.make_line(App.Vector(3, -20, 0), App.Vector(3, 20, 0))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        AF.setSetting("useSnapping", True)
        only_snap("Intersection")
        start()
        mouse_at(App.Vector(-10, 4, 0))  # register first edge in Draft snap history
        mouse_at(App.Vector(3, 10, 0))   # register the crossing edge, away from overlap
        mouse_at(App.Vector(3.2, 4, 0), True)
        results["intersection_diagnostic"] = {
            "history": list(Gui.Snapper.lastObj),
            "subelements": list(Gui.Snapper.lastObjSubelements),
            "snap_info": str(Gui.Snapper.snapInfo),
        }
        equal([list(gui._session.first)], [[3, 4, 0]])
        return list(gui._session.first)

    def transaction_failure(doc):
        import Draft
        original = Draft.make_line

        def fail_after_create(*args):
            original(*args)
            raise RuntimeError("intentional transaction rollback test")

        start()
        enter((0, 0, 0))
        action("ConfirmPoint")
        Draft.make_line = fail_after_create
        try:
            enter((10, 0, 0))
            action("ConfirmPoint")
        finally:
            Draft.make_line = original
        assert not doc.Objects and gui._session is None and not AF.isActive()

