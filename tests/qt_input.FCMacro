    def circle_keyin_reject_retry(doc):
        def state_copy():
            session = gui._session
            center = None
            if session is not None and session.first is not None:
                center = [float(session.first.x), float(session.first.y), float(session.first.z)]
            origin = AF.getState()["origin"]
            return {
                "center": center,
                "origin": [float(origin[0]), float(origin[1]), float(origin[2])],
                "objects": [obj.Name for obj in doc.Objects],
                "session": id(session) if session is not None else None,
            }

        def rejected(text, message):
            before = state_copy()
            keyin_submit(text)
            _, edit, _, error = keyin_widgets()
            after = state_copy()
            error_text = str(error.text())
            selected = str(edit.selectedText())
            assert error_text == message
            assert selected == text
            assert after == before
            assert after["session"] is not None
            return {"before": before, "after": after, "error": error_text, "selected": selected}

        circle_start()
        no_base = rejected(
            "rel 1; 0; 0",
            "Сначала задайте абсолютную точку или выберите точку мышью")
        bad_format = rejected(
            "abs 1; 2",
            "Нужно указать ровно три координаты через точку с запятой")
        off_plane = rejected(
            "abs 1; 2; 3",
            "Choose a point in the working plane captured at command start.")
        keyin_submit("abs 1; 2; 0")
        _, edit, _, _ = keyin_widgets()
        assert edit.text() == ""
        equal([list(gui._session.first)], [[1, 2, 0]])
        zero_radius = rejected("rel 0; 0; 0", "Choose a finite, non-zero radius.")
        off_plane_rel = rejected(
            "rel 0; 0; 1",
            "Choose a point in the working plane captured at command start.")
        keyin_submit("rel 3; 4; 0")
        assert len(doc.Objects) == 1
        check_circle(doc.Objects[0], App.Vector(1, 2, 0), 5)
        radius = float(doc.Objects[0].Shape.Edges[0].Curve.Radius)
        return {
            "no_base": no_base,
            "bad_format": bad_format,
            "off_plane": off_plane,
            "zero_radius": zero_radius,
            "off_plane_rel": off_plane_rel,
            "radius": radius,
        }

