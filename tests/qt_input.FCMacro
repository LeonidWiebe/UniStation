        assert gui._session.backend.lines.numVertices[0] == 129
        action("ConfirmPoint")
        expected = [App.Vector(0, 0, 0), App.Vector(5, 5, 0), App.Vector(10, 0, 0)]
        check_arc(doc.Objects[0], expected)
        assert doc.UndoCount == 1
        doc.undo()
        assert not doc.Objects
        doc.redo()
        check_arc(doc.Objects[0], expected)
        path = str(output_dir / "arc.FCStd")
        doc.saveAs(path)
        App.closeDocument(doc.Name)
        reopened = App.openDocument(path)
        check_arc(reopened.Objects[0], expected)

    def arc_directions(doc):
        for angles in ((0, 45, 90), (0, -45, -90), (0, 180, 270), (0, -180, -270)):
            # AxisFlow's decimal fields do not accept scientific notation.
            expected = [App.Vector(round(10*math.cos(math.radians(a)), 8),
                                   round(10*math.sin(math.radians(a)), 8), 0) for a in angles]
            arc_start()
            for p in expected[:2]:
                enter(tuple(p))
                action("ConfirmPoint")
            equal([list(p) for p in gui._session.points], [list(p) for p in expected[:2]])
            enter(tuple(expected[2]))
            action("ConfirmPoint")
            check_arc(doc.Objects[-1], expected)

