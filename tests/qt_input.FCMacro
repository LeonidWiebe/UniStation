"""In-process Qt GUI regression tests, no direct UniStation point callbacks."""
import json
import sys
import traceback
import hashlib
import math
import os
import uuid
from datetime import datetime, timezone
from pathlib import Path
import FreeCAD as App
import FreeCADGui as Gui
from PySide import QtCore, QtGui, QtWidgets
try:
    from PySide6.QtTest import QTest
except ImportError:
    from PySide2.QtTest import QTest

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "UniStation"))
sys.path.insert(0, str(root / "tests"))
import gui_diagnostics
output_dir = Path(os.environ.get("UNISTATION_TEST_OUTPUT", str(root / "test-output")))
output_dir.mkdir(parents=True, exist_ok=True)
output = output_dir / "qt-input.json"
results = {"freecad": App.Version(), "method": "QtTest events, no point injection",
           "python": sys.version, "qt": QtCore.qVersion(),
           "user_data": App.getUserAppDataDir(),
           "started_at": datetime.now(timezone.utc).isoformat(),
           "status": "running", "cases": []}
output.write_text(json.dumps(results, indent=2), encoding="utf-8")


def run_one_case(name, test, doc, begin_context, record_failure, cleanup):
    """Run one case. Diagnostics are recorded before cleanup; cleanup always runs."""
    try:
        begin_context(name, doc)
        detail = test(doc)
        return {"name": name, "status": "passed", "detail": detail}
    except Exception:
        original_error = traceback.format_exc()
        entry = {"name": name, "status": "failed", "error": original_error}
        try:
            extra = record_failure(name, original_error)
        except Exception as error:
            extra = {"diagnostics_error": "%s: %s" % (type(error).__name__, error)}
        if extra:
            entry.update(extra)
        entry["name"] = name
        entry["status"] = "failed"
        entry["error"] = original_error
        return entry
    finally:
        cleanup()


def select_axisflow_cases(registered_names, catalog, requested):
    """Return registered Qt names allowed for this run, in registration order."""
    if not isinstance(catalog, dict):
        raise ValueError("current_scope.json must contain an object")
    if catalog.get("schema_version") != 1:
        raise ValueError("Unsupported current_scope schema_version")
    if catalog.get("scope") != "axisflow-core":
        raise ValueError("current_scope scope must be axisflow-core")
    reason = catalog.get("reason")
    if not isinstance(reason, str) or not reason.strip():
        raise ValueError("current_scope reason is missing")
    included = catalog.get("included_qt")
    deferred_items = catalog.get("deferred_qt")
    if not isinstance(included, list) or not included:
        raise ValueError("included_qt must be a non-empty list")
    if not all(isinstance(name, str) and name for name in included):
        raise ValueError("included_qt names must be non-empty strings")
    if len(included) != len(set(included)):
        raise ValueError("included_qt contains duplicate names")
    if not isinstance(deferred_items, list):
        raise ValueError("deferred_qt must be a list")
    deferred = []
    for item in deferred_items:
        if not isinstance(item, dict):
            raise ValueError("deferred_qt entries must be objects")
        name = item.get("name")
        item_reason = item.get("reason")
        if not isinstance(name, str) or not name:
            raise ValueError("deferred_qt name is missing")
        if not isinstance(item_reason, str) or "deferred_by_scope" not in item_reason:
            raise ValueError("deferred_qt reason must state deferred_by_scope")
        if name in deferred:
            raise ValueError("deferred_qt contains duplicate names")
        deferred.append(name)
    if set(included) & set(deferred):
        raise ValueError("A Qt case is both included and deferred")
    registered = list(registered_names)
    if not registered or len(registered) != len(set(registered)):
        raise ValueError("Registered Qt cases are missing or duplicated")
    covered = set(included) | set(deferred)
    if covered != set(registered) or len(included) + len(deferred) != len(registered):
        raise ValueError("current_scope.json does not cover the registered Qt cases")
    _require_unit_lists(catalog)
    if requested:
        wanted = requested.split(",")
        registered_set = set(registered)
        deferred_set = set(deferred)
        unknown = sorted({name for name in wanted if name not in registered_set})
        blocked = sorted({name for name in wanted if name in deferred_set})
        if unknown or blocked:
            parts = []
            if unknown:
                parts.append("Unknown GUI cases: " + repr(unknown))
            if blocked:
                parts.append(
                    "Deferred GUI cases are outside axisflow-core: " + repr(blocked))
            raise ValueError("; ".join(parts))
        wanted_set = set(wanted)
        return [name for name in registered if name in wanted_set]
    included_set = set(included)
    return [name for name in registered if name in included_set]


def _class_name(value, label):
    if not isinstance(value, str) or value.count(".") != 1:
        raise ValueError(label + " must be module.Class")
    module_name, class_name = value.split(".")
    if not module_name or not class_name:
        raise ValueError(label + " must be module.Class")
    return value


def _require_unit_lists(catalog):
    included = catalog.get("included_unit")
    deferred_items = catalog.get("deferred_unit")
    if not isinstance(included, list) or not included:
        raise ValueError("included_unit must be a non-empty list")
    names = [_class_name(value, "included_unit") for value in included]
    if len(names) != len(set(names)):
        raise ValueError("included_unit contains duplicate classes")
    if not isinstance(deferred_items, list) or not deferred_items:
        raise ValueError("deferred_unit must be a non-empty list")
    deferred = []
    for item in deferred_items:
        if not isinstance(item, dict):
            raise ValueError("deferred_unit entries must be objects")
        class_name = _class_name(item.get("class"), "deferred_unit")
        item_reason = item.get("reason")
        if not isinstance(item_reason, str) or "deferred_by_scope" not in item_reason:
            raise ValueError("deferred_unit reason must state deferred_by_scope")
        if class_name in deferred:
            raise ValueError("deferred_unit contains duplicate classes")
        deferred.append(class_name)
    if set(names) & set(deferred):
        raise ValueError("A unit class is both included and deferred")

def run():
    import AxisFlow as AF
    import WorkingPlane
    from unistation import gui
    results["axisflow_binary"] = AF.__file__
    from runtime_metadata import native_modules
    results["native_modules"] = native_modules()
    results["axisflow_sha256"] = hashlib.sha256(Path(AF.__file__).read_bytes()).hexdigest()
    Gui.activateWorkbench("DraftWorkbench")
    Gui.activateWorkbench("UniStationWorkbench")
    results["hotkeys"] = AF.getSettings()["hotkeys"]
    AF.setSetting("smartNegativeDirection", False)
    AF.setSetting("focusAdvanceOnMove", False)
    AF.setSetting("compassFollowDirection", 0)
    AF.setSetting("useSnapping", False)
    AF.setSetting("useAxesIndexing", False)
    AF.setSetting("useDistanceIndexing", False)
    # Retain wrappers for C++-owned top-level addon widgets throughout the test.
    widget_refs = []
    trace = gui_diagnostics.CaseTrace(str(uuid.uuid4()))

    def wait():
        QTest.qWait(100)

    def panel():
        top_levels = QtWidgets.QApplication.topLevelWidgets()
        widget_refs.extend(top_levels)
        candidates = [w for w in top_levels
                      if len(w.findChildren(QtWidgets.QLineEdit)) == 3
                      and any(l.text() == "AxisFlow"
                              for l in w.findChildren(QtWidgets.QLabel))]
        assert len(candidates) == 1, repr([(w.metaObject().className(), w.windowTitle())
                                         for w in QtWidgets.QApplication.topLevelWidgets()])
        return candidates[0]

    def fields():
        return panel().findChildren(QtWidgets.QLineEdit)

    def keyin_widgets():
        task_panel = gui._session.backend.panel
        form = task_panel.form
        edit = form.findChild(QtWidgets.QLineEdit, "unistation_keyin")
        apply = form.findChild(QtWidgets.QPushButton, "unistation_keyin_apply")
        error = form.findChild(QtWidgets.QLabel, "unistation_keyin_error")
        assert edit is not None and apply is not None and error is not None
        return task_panel, edit, apply, error

    def keyin_submit(text, by="return"):
        _, edit, apply, _ = keyin_widgets()
        edit.window().activateWindow()
        wait()
        edit.setFocus()
        assert QtWidgets.QApplication.focusWidget() is edit, "Key-in field did not receive focus"
        edit.selectAll()
        QTest.keyClicks(edit, text)
        if by == "return":
            QTest.keyClick(edit, QtCore.Qt.Key_Return)
        elif by == "button":
            QTest.mouseClick(apply, QtCore.Qt.LeftButton)
        else:
            raise ValueError("Unknown key-in submit method: " + by)
        wait()

    def enter(values):
        # QTest targets a widget, while AxisFlow's app filter routes by actual
        # QApplication focus. Establish both, including in a hidden test window.
        panel().activateWindow()
        wait()
        for edit, value in zip(fields(), values):
            edit.setFocus()
            assert QtWidgets.QApplication.focusWidget() is edit, "AxisFlow field did not receive focus"
            edit.selectAll()
            QTest.keyClicks(edit, str(value))
        wait()

    def action(name):
        keys = AF.getSettings()["hotkeys"][name]
        assert keys, "Unbound action: " + name
        chord = keys[0] if isinstance(keys[0], list) else [keys[0]]
        for key in chord:
            QTest.keyClick(fields()[0], QtCore.Qt.Key(key))
        wait()

    def frame(world):
        button = panel().findChildren(QtWidgets.QPushButton)[0]
        world_label = QtCore.QCoreApplication.translate("AxisFlowGui::AxisFlowPanel", "World")
        if (button.text() == world_label) != world:
            QTest.mouseClick(button, QtCore.Qt.LeftButton)
        wait()

    def points(obj):
        return [list(v.Point) for v in obj.Shape.Vertexes]

    def equal(actual, expected):
        assert len(actual) == len(expected), (actual, expected)
        for a, e in zip(actual, expected):
            assert (App.Vector(*a) - App.Vector(*e)).Length < 1e-6, (actual, expected)

    def start():
        gui.start()
        AF.setMode("rect")
        frame(False)
        wait()

    def numeric(doc):
        start()
        enter((1, 2, 3))
        action("ConfirmPoint")
        assert gui._session.first is not None
        enter((-4.5, 6.25, 0))
        action("ConfirmPoint")
        equal(points(doc.Objects[0]), [[1, 2, 3], [-3.5, 8.25, 3]])
        assert gui._session is None and not AF.isActive()
        return points(doc.Objects[0])

    def world(doc):
        start()
        frame(True)
        enter((10, 20, 0))
        action("ConfirmPoint")
        enter((15, 27, 0))
        action("ConfirmPoint")
        equal(points(doc.Objects[0]), [[10, 20, 0], [15, 27, 0]])
        return points(doc.Objects[0])

    def keyin_absolute_relative_undo(doc):
        doc.UndoMode = 1
        before = doc.UndoCount
        start()
        keyin_submit("abs 10; 20; 0", "button")
        equal([list(gui._session.first)], [[10, 20, 0]])
        assert not doc.Objects and doc.UndoCount == before
        keyin_submit("rel 5 cm; -2 cm; 0")
        assert gui._session is None and not AF.isActive()
        assert len(doc.Objects) == 1 and doc.UndoCount == before + 1
        equal(points(doc.Objects[0]), [[10, 20, 0], [60, 0, 0]])
        doc.undo()
        assert not doc.Objects
        doc.redo()
        assert len(doc.Objects) == 1
        equal(points(doc.Objects[0]), [[10, 20, 0], [60, 0, 0]])

    def keyin_invalid_retry(doc):
        start()
        state_origin = list(AF.getState()["origin"])
        keyin_submit("rel 1; 2; 3")
        _, edit, _, error = keyin_widgets()
        assert error.text() and edit.selectedText() == "rel 1; 2; 3"
        assert gui._session.first is None and gui._session.origin is not None
        equal([list(AF.getState()["origin"])], [state_origin])
        assert gui._session is not None and AF.isActive() and not doc.Objects
        keyin_submit("abs 1,5; 2; 3")
        _, edit, _, error = keyin_widgets()
        assert error.text() and edit.selectedText() == "abs 1,5; 2; 3"
        assert gui._session.first is None and not doc.Objects
        equal([list(AF.getState()["origin"])], [state_origin])
        keyin_submit("abs 1; 2; 3")
        equal([list(gui._session.first)], [[1, 2, 3]])

    def keyin_duplicate_retry(doc):
        start()
        keyin_submit("abs 1; 2; 3")
        first = gui._session.first
        origin = list(AF.getState()["origin"])
        keyin_submit("rel 0; 0; 0")
        _, edit, _, error = keyin_widgets()
        assert error.text() and edit.selectedText() == "rel 0; 0; 0"
        assert gui._session.first is first and not doc.Objects
        equal([list(AF.getState()["origin"])], [origin])
        keyin_submit("rel 2; 0; 0")
        assert gui._session is None and len(doc.Objects) == 1
        equal(points(doc.Objects[0]), [[1, 2, 3], [3, 2, 3]])

    def keyin_after_axisflow_world(doc):
        start()
        frame(True)
        enter((10, 20, 0))
        action("ConfirmPoint")
        equal([list(gui._session.first)], [[10, 20, 0]])
        keyin_submit("rel 5 cm; -2 cm; 0")
        assert gui._session is None and len(doc.Objects) == 1
        equal(points(doc.Objects[0]), [[10, 20, 0], [60, 0, 0]])

    def keyin_after_mouse_world(doc):
        click = App.Vector(-10, -5, 0)
        doc.UndoMode = 1
        before = doc.UndoCount
        start()
        frame(True)
        mouse_at(click, True)
        assert gui._session is not None and AF.isActive()
        assert gui._session.first is not None and not doc.Objects
        assert doc.UndoCount == before
        # Value copy: session.first may later be replaced or mutated.
        accepted = (float(gui._session.first.x), float(gui._session.first.y),
                    float(gui._session.first.z))
        assert (App.Vector(*accepted) - click).Length < 1, accepted
        keyin_submit("rel 0; 5; 0")
        assert gui._session is None and not AF.isActive()
        assert len(doc.Objects) == 1 and doc.UndoCount == before + 1
        obj = doc.Objects[0]
        assert obj.Shape.isValid() and len(obj.Shape.Edges) == 1
        expected = [list(accepted), [accepted[0], accepted[1] + 5.0, accepted[2]]]
        equal(points(obj), expected)
        length = float(obj.Shape.Length)
        assert abs(length - 5) < 1e-7, length
        vertices = points(obj)
        undo_count = doc.UndoCount
        doc.undo()
        objects_after_undo = len(doc.Objects)
        assert objects_after_undo == 0
        doc.redo()
        assert len(doc.Objects) == 1
        redone = points(doc.Objects[0])
        equal(redone, vertices)
        return {"target": [[-10.0, -5.0, 0.0], [0.0, 5.0, 0.0]],
                "accepted_first": list(accepted),
                "vertices": vertices,
                "length": length,
                "undo_count_before": before,
                "undo_count_after": undo_count,
                "objects_after_undo": objects_after_undo,
                "redo_vertices": redone}

    def mouse_after_keyin_world(doc):
        click = App.Vector(10, 5, 0)
        doc.UndoMode = 1
        before = doc.UndoCount
        start()
        frame(True)
        keyin_submit("abs -10; -10; 0")
        assert gui._session is not None and AF.isActive()
        assert gui._session.first is not None and not doc.Objects
        assert doc.UndoCount == before
        equal([list(gui._session.first)], [[-10, -10, 0]])
        equal([list(AF.getState()["origin"])], [[-10, -10, 0]])
        mouse_at(click, True)
        assert gui._session is None and not AF.isActive()
        assert len(doc.Objects) == 1 and doc.UndoCount == before + 1
        obj = doc.Objects[0]
        assert obj.Shape.isValid() and len(obj.Shape.Edges) == 1
        vertices = points(obj)
        equal([vertices[0]], [[-10, -10, 0]])
        end_error = (App.Vector(*vertices[1]) - click).Length
        assert end_error < 1, vertices[1]
        length = float(obj.Shape.Length)
        assert abs(length - 25) < 1, length
        undo_count = doc.UndoCount
        doc.undo()
        objects_after_undo = len(doc.Objects)
        assert objects_after_undo == 0
        doc.redo()
        assert len(doc.Objects) == 1
        redone = points(doc.Objects[0])
        equal(redone, vertices)
        return {"target": [[-10.0, -10.0, 0.0], [10.0, 5.0, 0.0]],
                "vertices": vertices,
                "length": length,
                "endpoint_error": end_error,
                "undo_count_before": before,
                "undo_count_after": undo_count,
                "objects_after_undo": objects_after_undo,
                "redo_vertices": redone}

    def line_visual_checkpoints(doc):
        visual_dir = output_dir / "line-visual"
        if visual_dir.exists():
            raise RuntimeError("line-visual already exists")
        visual_dir.mkdir()
        started = datetime.now(timezone.utc).isoformat()
        checkpoints = []
        report_path = visual_dir / "checkpoints.json"

        def persist():
            payload = {"task_id": "GROK-002", "input_method": "qt",
                       "os_input_verified": False, "visual_review": "pending",
                       "started_at": started, "checkpoints": checkpoints}
            report_path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
                                   encoding="utf-8")

        def plain_point(value):
            return [float(value[0]), float(value[1]), float(value[2])]

        def session_state():
            active = gui._session is not None
            first = None
            if active and gui._session.first is not None:
                first = plain_point(gui._session.first)
            return {"session_active": active, "axisflow_active": bool(AF.isActive()),
                    "first": first}

        def document_objects():
            described = []
            for obj in doc.Objects:
                described.append({
                    "name": str(obj.Name),
                    "vertices": [[float(component) for component in vertex]
                                 for vertex in points(obj)],
                    "length": float(obj.Shape.Length),
                })
            return described

        def preview_state(active_backend):
            if active_backend is None or bool(active_backend.closed):
                return {"num_vertices": None, "vertices": None, "endpoint_error": None}
            count = int(active_backend.lines.numVertices[0])
            vertices = []
            if count > 0:
                values = active_backend.coords.point.getValues()
                vertices = [plain_point(values[index]) for index in range(count)]
            return {"num_vertices": count, "vertices": vertices, "endpoint_error": None}

        def keyin_state(form_alive):
            if not form_alive:
                return {"text": None, "error": None, "selected_text": None}
            _, edit, _, error = keyin_widgets()
            return {"text": edit.text(), "error": error.text(),
                    "selected_text": edit.selectedText()}

        def focus_state():
            widget = QtWidgets.QApplication.focusWidget()
            if widget is None:
                return {"object_name": None, "class_name": None}
            return {"object_name": str(widget.objectName()),
                    "class_name": str(widget.metaObject().className())}

        def read_png(path):
            assert path.is_file(), str(path)
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            image = QtGui.QImage(str(path))
            assert image.isNull() == False, str(path)
            assert image.width() > 0 and image.height() > 0, str(path)
            return {"path": path.relative_to(output_dir).as_posix(),
                    "sha256": digest,
                    "width": int(image.width()), "height": int(image.height())}

        def save_grab(widget, path):
            saved = widget.grab().save(str(path), "PNG")
            assert saved == True, (str(path), saved)
            return read_png(path)

        def scene_size():
            gl = viewport()
            dpr = float(gl.devicePixelRatioF())
            width = int(round(gl.width() * dpr))
            height = int(round(gl.height() * dpr))
            assert width > 0 and height > 0, (width, height, dpr)
            return gl, dpr, width, height

        def project_endpoints(world_points):
            # getPointOnScreen is already in physical viewport pixels; do not flip Y.
            _, _, width, height = scene_size()
            view = Gui.activeDocument().activeView()
            endpoints = []
            for point in world_points:
                xyz = [float(point[0]), float(point[1]), float(point[2])]
                x, y = view.getPointOnScreen(App.Vector(*xyz))
                screen = [float(x), float(y)]
                assert 32 <= screen[0] < width - 32 and 32 <= screen[1] < height - 32, (
                    xyz, screen, width, height)
                endpoints.append({"point": xyz, "screen": screen})
            return {"width": width, "height": height, "margin": 32, "endpoints": endpoints}

        def capture(checkpoint_id, sequence, active_backend, form_alive, target=None,
                    projected_endpoints=None):
            wait()
            window = Gui.getMainWindow()
            gl, dpr, scene_width, scene_height = scene_size()
            preview = preview_state(active_backend)
            if target is not None and preview["vertices"]:
                preview["endpoint_error"] = float(
                    (App.Vector(*preview["vertices"][-1]) - App.Vector(*target[-1])).Length)
            focus = focus_state()
            keyin = keyin_state(form_alive)
            observed = session_state()
            objects = document_objects()
            window_info = save_grab(window, visual_dir / (checkpoint_id + "-window.png"))
            scene_path = visual_dir / (checkpoint_id + "-scene.png")
            Gui.activeDocument().activeView().saveImage(
                str(scene_path), scene_width, scene_height, "Current")
            scene_info = read_png(scene_path)
            panel_info = None
            if form_alive:
                panel_info = save_grab(active_backend.panel.form,
                                       visual_dir / (checkpoint_id + "-panel.png"))
            checkpoints.append({
                "id": checkpoint_id,
                "sequence": sequence,
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "session_active": observed["session_active"],
                "axisflow_active": observed["axisflow_active"],
                "first": observed["first"],
                "objects": objects,
                "preview": preview,
                "preview_target": target,
                "backend_closed": bool(active_backend.closed),
                "keyin": keyin,
                "focus": focus,
                "dpr": dpr,
                "logical_size": {
                    "window": [int(window.width()), int(window.height())],
                    "viewport": [int(gl.width()), int(gl.height())],
                },
                "scene_pixels": [scene_width, scene_height],
                "projected_endpoints": projected_endpoints,
                "images": {"window": window_info, "scene": scene_info, "panel": panel_info},
            })
            persist()
            return checkpoints[-1]

        def assert_saved_line(shot, name):
            assert len(doc.Objects) == 1 and len(shot["objects"]) == 1
            obj = doc.Objects[0]
            assert obj.Name == name and shot["objects"][0]["name"] == name
            assert obj.Shape.isValid() and len(obj.Shape.Edges) == 1
            equal(shot["objects"][0]["vertices"], [[-1, -1, 0], [1, 0.5, 0]])
            assert abs(shot["objects"][0]["length"] - 2.5) < 1e-7, shot["objects"][0]["length"]

        persist()
        start()
        frame(True)
        backend = gui._session.backend
        initial = capture("initial", 1, backend, True)
        _, edit, apply, _ = keyin_widgets()
        assert edit.isEnabled() and apply.isEnabled()
        assert initial["session_active"] is True and initial["axisflow_active"] is True
        assert gui._session is not None and gui._session.first is None and initial["first"] is None
        assert AF.isActive() and not doc.Objects and initial["objects"] == []
        assert initial["preview"]["num_vertices"] == 0 and initial["backend_closed"] is False
        assert initial["images"]["panel"] is not None

        keyin_submit("abs 1; 2")
        invalid = capture("invalid", 2, backend, True)
        assert invalid["keyin"]["error"]
        assert invalid["keyin"]["text"] == "abs 1; 2"
        assert invalid["keyin"]["selected_text"] == "abs 1; 2"
        assert invalid["first"] is None and gui._session.first is None
        assert invalid["objects"] == [] and not doc.Objects
        assert invalid["session_active"] is True and invalid["axisflow_active"] is True
        assert gui._session is not None and AF.isActive()
        assert invalid["backend_closed"] is False and invalid["images"]["panel"] is not None

        line_target = [[-1.0, -1.0, 0.0], [1.0, 0.5, 0.0]]
        keyin_submit("abs -1; -1; 0")
        line_target_projection = project_endpoints(line_target)
        mouse_at(App.Vector(1, 0.5, 0), False)
        preview_now = preview_state(backend)
        assert preview_now["num_vertices"] == 2
        preview_projection = project_endpoints(preview_now["vertices"])
        preview = capture("preview", 3, backend, True, line_target, {
            "target": line_target_projection, "preview": preview_projection, "line": None})
        equal([preview["first"]], [line_target[0]])
        equal([list(gui._session.first)], [line_target[0]])
        assert preview["keyin"]["error"] == ""
        assert preview["objects"] == [] and not doc.Objects
        assert preview["preview"]["num_vertices"] == 2
        equal([preview["preview"]["vertices"][0]], [line_target[0]])
        assert preview["preview"]["endpoint_error"] < 0.05, preview["preview"]["vertices"][1]
        assert preview["session_active"] is True and preview["axisflow_active"] is True
        assert preview["backend_closed"] is False and preview["images"]["panel"] is not None

        keyin_submit("rel 2; 1.5; 0")
        created_projection = project_endpoints(points(doc.Objects[0]))
        committed = capture("committed", 4, backend, False, projected_endpoints={
            "target": None, "preview": None, "line": created_projection})
        assert gui._session is None and not AF.isActive()
        assert committed["session_active"] is False and committed["axisflow_active"] is False
        assert committed["backend_closed"] is True and backend.closed is True
        assert committed["keyin"]["text"] is None and committed["keyin"]["error"] is None
        assert committed["keyin"]["selected_text"] is None
        assert committed["preview"]["num_vertices"] is None and committed["images"]["panel"] is None
        assert_saved_line(committed, doc.Objects[0].Name)
        committed_name = doc.Objects[0].Name

        start()
        frame(True)
        backend2 = gui._session.backend
        cancel_target = [[-1.0, 0.5, 0.0], [1.0, -0.5, 0.0]]
        keyin_submit("abs -1; 0.5; 0")
        cancel_target_projection = project_endpoints(cancel_target)
        mouse_at(App.Vector(1, -0.5, 0), False)
        cancel_now = preview_state(backend2)
        assert cancel_now["num_vertices"] == 2
        cancel_preview_projection = project_endpoints(cancel_now["vertices"])
        saved_line_projection = project_endpoints(points(doc.Objects[0]))
        cancel_preview = capture("cancel_preview", 5, backend2, True, cancel_target, {
            "target": cancel_target_projection, "preview": cancel_preview_projection,
            "line": saved_line_projection})
        assert_saved_line(cancel_preview, committed_name)
        equal([cancel_preview["first"]], [cancel_target[0]])
        equal([list(gui._session.first)], [cancel_target[0]])
        assert cancel_preview["preview"]["num_vertices"] == 2
        equal([cancel_preview["preview"]["vertices"][0]], [cancel_target[0]])
        assert cancel_preview["preview"]["endpoint_error"] < 0.05, cancel_preview["preview"]["vertices"][1]
        assert cancel_preview["session_active"] is True and cancel_preview["axisflow_active"] is True
        assert cancel_preview["backend_closed"] is False
        assert cancel_preview["images"]["panel"] is not None

        _, edit, _, _ = keyin_widgets()
        edit.window().activateWindow()
        wait()
        edit.setFocus()
        assert QtWidgets.QApplication.focusWidget() is edit, "Key-in field did not receive focus"
        QTest.keyClick(edit, QtCore.Qt.Key_Escape)
        wait()
        cancelled_line_projection = project_endpoints(points(doc.Objects[0]))
        cancelled = capture("cancelled", 6, backend2, False, projected_endpoints={
            "target": None, "preview": None, "line": cancelled_line_projection})
        assert gui._session is None and not AF.isActive()
        assert cancelled["session_active"] is False and cancelled["axisflow_active"] is False
        assert cancelled["backend_closed"] is True and backend2.closed is True
        assert cancelled["keyin"]["text"] is None and cancelled["images"]["panel"] is None
        assert cancelled["preview"]["num_vertices"] is None
        assert_saved_line(cancelled, committed_name)
        pngs = list(visual_dir.glob("*.png"))
        assert len(checkpoints) == 6 and len(pngs) == 16, (len(checkpoints), len(pngs))
        return {"checkpoints": str(report_path), "points": 6, "images": 16,
                "visual_review": "pending", "os_input_verified": False}

