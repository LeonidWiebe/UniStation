    def observation_readers():
        def document_names():
            documents = App.listDocuments()
            if isinstance(documents, dict):
                return [str(name) for name in documents]
            names = []
            for item in documents:
                name = getattr(item, "Name", None)
                names.append(str(item if name is None else name))
            return names

        def active_document_name():
            document = App.ActiveDocument
            return None if document is None else str(document.Name)

        def gui_active_document():
            return Gui.activeDocument()

        def active_view():
            document = Gui.activeDocument()
            return None if document is None else document.activeView()

        def session():
            return getattr(gui, "_session", None)

        def axisflow_active():
            return AF.isActive()

        def retain(widget):
            if widget is not None:
                widget_refs.append(widget)
            return widget

        def focus_widget():
            return retain(QtWidgets.QApplication.focusWidget())

        def active_window():
            return retain(QtWidgets.QApplication.activeWindow())

        def mdi_area():
            window = Gui.getMainWindow()
            return None if window is None else retain(window.findChild(QtWidgets.QMdiArea))

        def find_children(parent, child_class):
            children = list(parent.findChildren(child_class))
            widget_refs.extend(children)
            return children

        def list_subwindows(area):
            windows = list(area.subWindowList())
            widget_refs.extend(windows)
            return windows

        return {
            "document_names": document_names,
            "active_document_name": active_document_name,
            "gui_active_document": gui_active_document,
            "active_view": active_view,
            "session": session,
            "axisflow_active": axisflow_active,
            "focus_widget": focus_widget,
            "active_window": active_window,
            "mdi_area": mdi_area,
            "widget_class": lambda: QtWidgets.QWidget,
            "find_children": find_children,
            "list_subwindows": list_subwindows,
            "retain": retain,
        }

    def note_mouse(point, click, phase):
        trace.add_event(
            phase, (float(point.x), float(point.y), float(point.z)), click,
            gui_diagnostics.collect_snapshot(observation_readers()))

    def viewport():
        window = Gui.getMainWindow()
        mdi = None if window is None else window.findChild(QtWidgets.QMdiArea)
        widgets, candidates = gui_diagnostics.opengl_viewport_widgets(
            mdi, QtWidgets.QWidget)
        widget_refs.extend(widgets)
        return gui_diagnostics.require_single_opengl(widgets, candidates)

    def mouse_at(point, click=False):
        note_mouse(point, click, "before_view")
        view = Gui.activeDocument().activeView()
        gl = viewport()
        x, y = view.getPointOnScreen(point)
        dpr = gl.devicePixelRatioF()
        pos = QtCore.QPoint(
            round(x / dpr),
            round((round(gl.height() * dpr) - y - 1) / dpr))
        results["mouse_device_pixel_ratio"] = dpr
        results["mouse_logical_viewport_size"] = [int(gl.width()), int(gl.height())]
        # Feed Qt -> Quarter -> Coin -> AxisFlow, never call a point callback.
        # QTest.mouseMove uses the OS cursor on some platforms, so construct
        # the Qt move event explicitly for reproducibility in a hidden process.
        local = QtCore.QPointF(pos)
        event = QtGui.QMouseEvent(QtCore.QEvent.MouseMove, local,
                                 QtCore.QPointF(gl.mapToGlobal(pos)),
                                 QtCore.Qt.NoButton, QtCore.Qt.NoButton,
                                 QtCore.Qt.NoModifier)
        QtWidgets.QApplication.sendEvent(gl, event)
        wait()
        note_mouse(point, click, "after_move")
        if click:
            QTest.mouseClick(gl, QtCore.Qt.LeftButton, QtCore.Qt.NoModifier, pos)
            wait()
            note_mouse(point, click, "after_click")

    def mouse_line(doc):
        start()
        mouse_at(App.Vector(-10, -5, 0), True)
        assert gui._session.first is not None
        mouse_at(App.Vector(10, 5, 0), True)
        assert gui._session is None and len(doc.Objects) == 1
        # Screen projection is quantized to pixels.
        for actual, target in zip(doc.Objects[0].Shape.Vertexes,
                                  (App.Vector(-10, -5, 0), App.Vector(10, 5, 0))):
            assert (actual.Point - target).Length < 1, points(doc.Objects[0])
        return points(doc.Objects[0])

    def endpoint_snap(doc):
        import Draft
        import DraftTools
        reference = Draft.make_line(App.Vector(-20, 0, 0), App.Vector(20, 0, 0))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        AF.setSetting("useSnapping", True)
        only_snap("Endpoint")
        start()
        mouse_at(App.Vector(-20, 0, 0), True)
        mouse_at(App.Vector(20, 0, 0), True)
        assert gui._session is None and len(doc.Objects) == 2
        created = next(obj for obj in doc.Objects if obj is not reference)
        equal(points(created), [[-20, 0, 0], [20, 0, 0]])
        return points(created)

    def only_snap(mode):
        for name in Gui.Snapper.snaps:
            desired = name in ("Lock", mode)
            if (name in Gui.Snapper.active_snaps) != desired:
                Gui.Snapper.toggle_snap(name)

    def midpoint_snap(doc):
        import Draft
        import DraftTools
        Draft.make_line(App.Vector(-20, 10, 0), App.Vector(20, 10, 0))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        AF.setSetting("useSnapping", True)
        only_snap("Midpoint")
        start()
        mouse_at(App.Vector(1, 10, 0), True)
        equal([list(gui._session.first)], [[0, 10, 0]])
        return list(gui._session.first)

    def center_snap(doc):
        import Draft
        import DraftTools
        Draft.make_circle(20, placement=App.Placement(App.Vector(10, 5, 0), App.Rotation()))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        AF.setSetting("useSnapping", True)
        only_snap("Center")
        start()
        # Draft's Center snap targets points offset from quadrant snaps.
        angle = math.radians(75)
        mouse_at(App.Vector(10 + 20 * math.sin(angle), 5 + 20 * math.cos(angle), 0), True)
        equal([list(gui._session.first)], [[10, 5, 0]])
        return list(gui._session.first)

