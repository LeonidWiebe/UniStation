    def arc_start(world=True):
        Gui.runCommand("UniStation_Arc")
        AF.setMode("rect")
        frame(world)
        wait()

    def check_arc(obj, expected):
        import Part
        edge = obj.Shape.Edges[0]
        reference = Part.Arc(*expected).toShape()
        assert obj.Shape.isValid() and len(obj.Shape.Edges) == 1 and not obj.MakeFace
        assert not edge.isClosed()
        assert abs(edge.Length - reference.Length) < 1e-6, (edge.Length, reference.Length)
        for p in reference.discretize(Number=17):
            assert edge.distToShape(Part.Vertex(p))[0] < 1e-6
        for p in expected:
            assert edge.distToShape(Part.Vertex(p))[0] < 1e-6
        assert gui._session is None and not AF.isActive()

    def arc_local(doc):
        doc.UndoMode = 1
