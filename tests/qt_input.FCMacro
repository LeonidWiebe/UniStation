        objects = transform_fixture(doc)
        transform_start()
        objects[0].Placement.Base = App.Vector(2, 0, 0)
        doc.recompute()
        QTest.qWait(250)
        assert gui._session is None and not AF.isActive()
        transform_start(True)
        doc.removeObject(objects[0].Name)
        QTest.qWait(250)
        assert gui._session is None and not AF.isActive() and len(doc.Objects) == 1

    def transform_failure(doc):
        import Draft
        objects = transform_fixture(doc)
        initial = [App.Placement(o.Placement) for o in objects]
        original = Draft.move
        def fail(*args, **kwargs):
            original(*args, **kwargs)
            raise RuntimeError("intentional transform rollback test")
        for copy in (False, True):
            Gui.Selection.clearSelection()
            for obj in objects:
                Gui.Selection.addSelection(obj)
            transform_start(copy)
            Draft.move = fail
            try:
                wire_points(((0, 0, 0), (10, 0, 0)))
            finally:
                Draft.move = original
            assert gui._session is None and not AF.isActive() and len(doc.Objects) == 2
            assert all(o.Placement == p for o, p in zip(objects, initial))

    def transform_mouse(doc):
        objects = transform_fixture(doc)
        Gui.activeDocument().activeView().fitAll()
        AF.setSetting("useSnapping", True)
        only_snap("Endpoint")
        transform_start()
        mouse_at(App.Vector(0, 0, 0), True)
        mouse_at(App.Vector(10, 0, 0), True)
        assert gui._session is None and not AF.isActive()
        equal(points(objects[0]), [[10, 0, 0], [20, 0, 0]])

    def transform_lifecycle(doc):
        objects = transform_fixture(doc)
        transform_start()
        other = App.newDocument("TransformOther")
        QTest.qWait(250)
        assert gui._session is None and not other.Objects
        App.setActiveDocument(doc.Name)
        Gui.Selection.clearSelection()
        for obj in objects:
            Gui.Selection.addSelection(obj)
        transform_start(True)
        Gui.activateWorkbench("DraftWorkbench")
        wait()
        assert gui._session is None and len(doc.Objects) == 2
        Gui.activateWorkbench("UniStationWorkbench")
        transform_start()
        App.closeDocument(doc.Name)
        QTest.qWait(250)
        assert gui._session is None and not AF.isActive()

    def transform_geometry_types(doc):
        import Draft
        import Part
        wire = Draft.make_wire([App.Vector(), App.Vector(4, 0, 0), App.Vector(4, 3, 0)], closed=True, face=False)
        arc = Draft.make_circle(Part.Arc(App.Vector(10, 0, 0), App.Vector(12, 2, 0),
                                        App.Vector(14, 0, 0)).toShape(), face=False)
        solid = doc.addObject("Part::Feature", "Solid")
        solid.Shape = Part.makeBox(2, 3, 4)
        solid.Placement = App.Placement(App.Vector(20, 0, 0), App.Rotation(App.Vector(1, 0, 0), 30))
        doc.recompute()
        objects = [wire, arc, solid]
        initial = [App.Placement(o.Placement) for o in objects]
        lengths = [o.Shape.Length for o in objects]
        for copy in (False, True):
            Gui.Selection.clearSelection()
            for obj in objects:
                Gui.Selection.addSelection(obj)
            transform_start(copy, True)
            wire_points(((0, 0, 0), (3, 4, 5)))
            assert gui._session is None and not AF.isActive()
        assert len(doc.Objects) == 6
        copies = [o for o in doc.Objects if o not in objects]
        for obj, duplicate, placement, length in zip(objects, copies, initial, lengths):
            equal([list(obj.Placement.Base), list(duplicate.Placement.Base)],
                  [list(placement.Base + App.Vector(3, 4, 5)), list(placement.Base + App.Vector(6, 8, 10))])
            assert obj.Placement.Rotation.isSame(placement.Rotation, 1e-7)
            assert duplicate.Placement.Rotation.isSame(placement.Rotation, 1e-7)
            assert abs(obj.Shape.Length-length) < 1e-6 and abs(duplicate.Shape.Length-length) < 1e-6
        assert copies[0].Closed and len(copies[1].Shape.Edges) == 1 and len(copies[2].Shape.Solids) == 1

    setting_keys = ("smartNegativeDirection", "focusAdvanceOnMove", "compassFollowDirection",
                    "useSnapping", "useAxesIndexing", "useDistanceIndexing")

    def configured(test, settings):
        def wrapped(doc):
            saved = {key: AF.getSettings()[key] for key in settings}
            try:
                for key, value in settings.items():
                    AF.setSetting(key, value)
                detail = test(doc)
                return {"settings": settings, "detail": detail}
            finally:
                gui.cancel()
                for key, value in saved.items():
                    AF.setSetting(key, value)
        return wrapped

    defaults = {key: AF.getDefaultSettings()[key] for key in setting_keys}
    results["tested_factory_settings"] = defaults

    def move_world(doc):
        objects = transform_fixture(doc)
        initial = [App.Vector(o.Placement.Base) for o in objects]
        transform_start(world=True)
        wire_points(((10, 20, 0), (15, 27, 3)))
        equal([list(o.Placement.Base) for o in objects],
              [list(p + App.Vector(5, 7, 3)) for p in initial])
        assert gui._session is None and not AF.isActive()

    def direction_sign(doc):
        import Draft
        Draft.make_line(App.Vector(-40, -30, 0), App.Vector(40, 30, 0))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        start()
        frame(True)
        enter((0, 0, 0))
        action("ConfirmPoint")
        frame(False)
        mouse_at(App.Vector(-20, -10, 0))
        enter((5, 4, 0))
        action("ConfirmPoint")
        sign = -1 if AF.getSettings()["smartNegativeDirection"] else 1
        equal(points(doc.Objects[-1]), [[0, 0, 0], [sign*5, sign*4, 0]])

    def focus_advance(doc):
        start()
        enter((0, 0, 0))
        action("ConfirmPoint")
        mouse_at(App.Vector(10, 2, 0))
        edit = fields()[0]
        edit.setFocus()
        edit.selectAll()
        QTest.keyClicks(edit, "5")
        assert edit.hasFocus()
        mouse_at(App.Vector(20, 12, 0))
        assert fields()[1].hasFocus(), "Movement did not advance X entry to Y"
        assert gui._session is not None and not doc.Objects

    def follow_direction(doc):
        wire_start()
        wire_points(((0, 0, 0), (10, 10, 0), (10, 0, 0)))
        action("FinishLine")
        expected = 10 + 10 / math.sqrt(2)
        equal(points(doc.Objects[0]), [[0, 0, 0], [10, 10, 0], [expected, expected, 0]])

    def indexing_axis(doc):
        import Draft
        Draft.make_line(App.Vector(-30, -20, 0), App.Vector(30, 20, 0))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        start()
        enter((0, 0, 0))
        action("ConfirmPoint")
        mouse_at(App.Vector(20, 0.1, 0))
        results["axis_indexing_diagnostic"] = str(AF.getState())
        mouse_at(App.Vector(20, 0.1, 0), True)
        end = doc.Objects[-1].Shape.Vertexes[-1].Point
        assert abs(end.y) < 1e-6 and abs(end.x-20) < 1, list(end)

    def indexing_distance(doc):
        import Draft
        Draft.make_line(App.Vector(-30, -20, 0), App.Vector(30, 20, 0))
        doc.recompute()
        Gui.activeDocument().activeView().fitAll()
        start()
        enter((0, 0, 0))
        action("ConfirmPoint")
        AF.setIndexedDistance(10)
        try:
            mouse_at(App.Vector(6.1, 8.1, 0))
            results["distance_indexing_diagnostic"] = str(AF.getState())
            mouse_at(App.Vector(6.1, 8.1, 0), True)
            assert abs(doc.Objects[-1].Shape.Length-10) < 1e-6, points(doc.Objects[-1])
        finally:
            AF.clearIndexedDistance()

    def remapped_confirm(chord):
        def test(doc):
            saved = AF.getSettings()["hotkeys"]["ConfirmPoint"]
            binding = [[int(QtCore.Qt.Key_F6), int(QtCore.Qt.Key_F7)]] if chord else [int(QtCore.Qt.Key_F6)]
            AF.setHotkeys("ConfirmPoint", binding, False)
            try:
                start()
                hint = gui.key_hint(AF, "ConfirmPoint")
                assert "F6" in hint and (not chord or "F7" in hint)
                assert hint in gui._session.backend.panel.instructions.text()
                wire_points(((0, 0, 0), (10, 5, 0)))
                equal(points(doc.Objects[0]), [[0, 0, 0], [10, 5, 0]])
                assert gui._session is None and not AF.isActive()
            finally:
                AF.setHotkeys("ConfirmPoint", saved, False)
        return test

    settings_cases = [
        ("defaults_line", configured(world, defaults)),
        ("defaults_wire", configured(wire_pick_first, defaults)),
        ("defaults_circle", configured(circle_world, defaults)),
        ("defaults_arc", configured(arc_directions, defaults)),
        ("defaults_move", configured(move_world, defaults)),
        ("defaults_copy", configured(copy_world, defaults)),
        ("smart_negative_on", configured(direction_sign, {"smartNegativeDirection": True})),
        ("smart_negative_off", configured(direction_sign, {"smartNegativeDirection": False})),
        ("focus_advance_on_move", configured(focus_advance, {"focusAdvanceOnMove": True})),
        ("follow_direction_plane", configured(follow_direction, {"compassFollowDirection": 1})),
        ("follow_direction_full", configured(follow_direction, {"compassFollowDirection": 2})),
        ("axis_indexing_on", configured(indexing_axis, {"useAxesIndexing": True})),
        ("distance_indexing_on", configured(indexing_distance, {"useDistanceIndexing": True})),
        ("confirm_hotkey_remapped", remapped_confirm(False)),
        ("confirm_hotkey_chord", remapped_confirm(True)),
    ]

    cases = settings_cases + [("transform_geometry_types", transform_geometry_types),
             ("move_local_preview_undo", move_local), ("copy_world_undo_save", copy_world),
             ("transform_tilted_plane", transform_plane), ("transform_cancel_pending", transform_cancel_pending),
             ("transform_selection_rejection", transform_selection), ("transform_changed_objects", transform_changed),
             ("transform_rollback", transform_failure), ("transform_mouse_endpoint_snap", transform_mouse),
             ("transform_lifecycle", transform_lifecycle),
             ("arc_local_preview_undo_save", arc_local), ("arc_world_directions", arc_directions),
             ("arc_tilted_plane", arc_plane), ("arc_reject_retry", arc_retry),
             ("arc_cancel", arc_cancel), ("arc_mouse_endpoint_snap", arc_mouse),
             ("arc_lifecycle", arc_lifecycle), ("arc_rollback", arc_failure),
             ("circle_local_preview_undo_save", circle_local), ("circle_world", circle_world),
             ("circle_tilted_plane", circle_plane), ("circle_polar", circle_polar),
             ("circle_reject_retry", circle_reject), ("circle_cancel", circle_cancel),
             ("circle_mouse_endpoint_snap", circle_mouse), ("circle_lifecycle", circle_lifecycle),
             ("circle_rollback", circle_failure),
             ("wire_open_undo_save", wire_open), ("wire_closed_button", wire_closed),
             ("wire_closed_first_point_world", wire_pick_first), ("wire_cancel", wire_cancel),
             ("wire_mouse_endpoint_snap", wire_mouse_snap),
             ("wire_insufficient_points", wire_short), ("wire_tilted_plane", wire_plane),
             ("wire_lifecycle", wire_lifecycle), ("wire_rollback", wire_failure),
             ("numeric_local_signed_decimal", numeric), ("numeric_world", world),
             ("keyin_absolute_relative_units_undo", keyin_absolute_relative_undo),
             ("keyin_invalid_retry", keyin_invalid_retry),
             ("keyin_duplicate_retry", keyin_duplicate_retry),
             ("keyin_after_axisflow_world", keyin_after_axisflow_world),
             ("keyin_after_mouse_world", keyin_after_mouse_world),
             ("mouse_after_keyin_world", mouse_after_keyin_world),
             ("line_visual_checkpoints", line_visual_checkpoints),
             ("axisflow_after_keyin_local", axisflow_after_keyin_local),
             ("keyin_tilted_explicit_world", keyin_tilted_world),
             ("keyin_escape", keyin_escape), ("keyin_close_focused", keyin_close_focused),
             ("keyin_return_vs_smart_lock", keyin_return_vs_smart_lock),
             ("keyin_stale_panel", keyin_stale_panel),
             ("keyin_command_scope", keyin_command_scope),
             ("wire_keyin_relative_finish_undo", wire_keyin_relative_finish_undo),
             ("wire_keyin_reject_retry", wire_keyin_reject_retry),
             ("wire_keyin_close", wire_keyin_close),
             ("wire_keyin_escape", wire_keyin_escape),
             ("wire_keyin_after_mouse", wire_keyin_after_mouse),
             ("wire_mouse_after_keyin", wire_mouse_after_keyin),
             ("wire_keyin_tilted_world", wire_keyin_tilted_world),
             ("wire_keyin_lifecycle", wire_keyin_lifecycle),
             ("wire_keyin_return_vs_smart_lock", wire_keyin_return_vs_smart_lock),
             ("circle_keyin_units_undo", circle_keyin_units_undo),
             ("circle_keyin_reject_retry", circle_keyin_reject_retry),
             ("circle_keyin_after_mouse", circle_keyin_after_mouse),
             ("circle_mouse_after_keyin", circle_mouse_after_keyin),
             ("circle_keyin_tilted_world", circle_keyin_tilted_world),
             ("circle_keyin_escape", circle_keyin_escape),
             ("circle_keyin_lifecycle", circle_keyin_lifecycle),
             ("circle_keyin_return_vs_smart_lock", circle_keyin_return_vs_smart_lock),
             ("keyin_focus_probe", keyin_focus_probe),
             ("escape_during_entry", escape), ("panel_power_off_cleanup", power),
             ("polar_distance_angle", polar), ("translated_working_plane", translated_plane),
             ("tilted_working_plane", tilted_plane), ("enter_and_actual_hotkey_hint", smart_lock),
             ("mouse_two_points", mouse_line), ("endpoint_snapping", endpoint_snap),
             ("midpoint_snapping", midpoint_snap), ("center_snapping", center_snap),
             ("intersection_snapping", intersection_snap),
             ("axis_lock", axis_lock), ("numeric_unit_suffix_limit", numeric_unit_validator),
             ("transaction_rollback", transaction_failure), ("workbench_switches", workbench_switch),
             ("close_document", close_document)]
    requested = os.environ.get("UNISTATION_GUI_CASES", "")
    scope_path = root / "tests" / "current_scope.json"
    try:
        catalog_bytes = scope_path.read_bytes()
        catalog = json.loads(catalog_bytes.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ValueError(
            "current_scope.json is required and could not be read: " + str(exc)
        ) from exc
    registered_names = [name for name, _ in cases]
    selected_names = select_axisflow_cases(registered_names, catalog, requested)
    selected = set(selected_names)
    cases = [(name, test) for name, test in cases if name in selected]
    results["case_filter"] = requested or None
    results["scope"] = catalog["scope"]
    results["scope_reason"] = catalog["reason"]
    results["scope_sha256"] = hashlib.sha256(catalog_bytes).hexdigest()
    results["included_qt"] = list(catalog["included_qt"])
    results["deferred_qt"] = list(catalog["deferred_qt"])

    def begin_case(name, doc):
        trace.begin(name, doc.Name)

    def record_case_failure(name, original_error):
        payload = trace.failure_payload(
            original_error,
            gui_diagnostics.collect_snapshot(observation_readers()),
            os.getpid())
        path = gui_diagnostics.write_case_file(output_dir, name, payload)
        return {"diagnostics_path": str(path)}

    def cleanup_case():
        gui.cancel()
        AF.endSession()
        AF.setSetting("useSnapping", False)
        for remaining in list(App.listDocuments()):
            App.closeDocument(remaining)
        wait()

    for name, test in cases:
        App.Console.PrintLog("UniStation GUI case: " + name + "\n")
        doc = App.newDocument("QtInputTest")
        Gui.activeDocument().activeView().viewTop()
        wp = WorkingPlane.get_working_plane()
        wp.set_to_top()
        # Fixture state reset via public API; point acceptance always uses Qt events.
        AF.confirm(App.Vector())
        results["cases"].append(run_one_case(
            name, test, doc, begin_case, record_case_failure, cleanup_case))
        output.write_text(json.dumps(results, indent=2), encoding="utf-8")
    results["status"] = "passed" if all(c["status"] == "passed" for c in results["cases"]) else "failed"
    output.write_text(json.dumps(results, indent=2), encoding="utf-8")
    QtCore.QTimer.singleShot(0, Gui.getMainWindow().close)


def guarded_run():
    try:
        run()
    except Exception:
        results["status"] = "error"
        results["error"] = traceback.format_exc()
        output.write_text(json.dumps(results, indent=2), encoding="utf-8")
        Gui.getMainWindow().close()


QtCore.QTimer.singleShot(1500, guarded_run)

