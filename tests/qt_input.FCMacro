    def wire_keyin_lifecycle(doc):
        def point_copy(session):
            return [[float(point.x), float(point.y), float(point.z)]
                    for point in session.points]

        def origin_copy():
            origin = AF.getState()["origin"]
            return [float(origin[0]), float(origin[1]), float(origin[2])]

        def object_copy():
            return [obj.Name for obj in doc.Objects]

        wire_start()
        stale_panel, _, _, _ = keyin_widgets()
        keyin_submit("abs 1; 2; 3")
        assert len(gui._session.points) == 1
        gui.cancel()
        stale_panel.apply_coordinates()
        assert gui._session is None and not AF.isActive() and not doc.Objects
        wire_start()
        keyin_submit("abs 7; 8; 9")
        _, edit, _, _ = keyin_widgets()
        pending = "abs 4; 5; 6"
        edit.setText(pending)
        assert edit.text() == pending
        session = gui._session
        before_points = point_copy(session)
        before_origin = origin_copy()
        before_objects = object_copy()
        before_text = str(edit.text())
        stale_panel.apply_coordinates()
        after_points = point_copy(gui._session)
        after_origin = origin_copy()
        after_objects = object_copy()
        after_text = str(edit.text())
        same_session = gui._session is session
        assert same_session and gui._session.valid() and AF.isActive()
        assert after_points == before_points
        assert after_origin == before_origin
        assert after_objects == before_objects
        assert after_text == before_text
        edit.window().activateWindow()
        wait()
        edit.setFocus()
        focused = QtWidgets.QApplication.focusWidget() is edit
        assert focused, "Wire key-in field did not receive focus"
        App.closeDocument(doc.Name)
        QTest.qWait(250)
        released = gui._session is None and not AF.isActive()
        assert released
        return {
            "before_points": before_points,
            "after_points": after_points,
            "before_origin": before_origin,
            "after_origin": after_origin,
            "before_text": before_text,
            "after_text": after_text,
            "same_session": same_session,
            "focused_before_close": focused,
            "released": released,
        }

