    def circle_keyin_tilted_world(doc):
        def xyz(vector):
            return [float(vector.x), float(vector.y), float(vector.z)]

        def formatted(vector):
            return "abs {0:.12f}; {1:.12f}; {2:.12f}".format(vector.x, vector.y, vector.z)

        def state_copy():
            session = gui._session
            center = None
            if session is not None and session.first is not None:
                center = xyz(session.first)
            origin = AF.getState()["origin"]
            return {
                "center": center,
                "origin": [float(origin[0]), float(origin[1]), float(origin[2])],
                "objects": [obj.Name for obj in doc.Objects],
                "session": id(session) if session is not None else None,
            }

        wp = WorkingPlane.get_working_plane()
        wp.align_to_placement(App.Placement(App.Vector(3, 4, 25),
                                            App.Rotation(App.Vector(1, 0, 0), 30)))
        origin = App.Vector(wp.position)
        u, v, axis = App.Vector(wp.u), App.Vector(wp.v), App.Vector(wp.axis)
        saved = {"origin": xyz(origin), "u": xyz(u), "v": xyz(v), "axis": xyz(axis)}
        circle_start()
        keyin_submit(formatted(origin))
        equal([list(gui._session.first)], [saved["origin"]])
        before = state_copy()
        keyin_submit(formatted(origin + axis))
        _, edit, _, error = keyin_widgets()
        after = state_copy()
        assert str(error.text()) == "Choose a point in the working plane captured at command start."
        assert str(edit.selectedText()) == formatted(origin + axis)
        assert after == before and not doc.Objects
        keyin_submit(formatted(origin + u * 3 + v * 4))
        assert len(doc.Objects) == 1
        check_circle(doc.Objects[0], origin, 5, axis)
        curve = doc.Objects[0].Shape.Edges[0].Curve
        return {
            "plane": saved,
            "rejected_before": before,
            "rejected_after": after,
            "center": xyz(curve.Center),
            "radius": float(curve.Radius),
            "normal": xyz(curve.Axis),
        }

