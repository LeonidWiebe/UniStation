    def transform_fixture(doc):
        import Draft
        line = Draft.make_line(App.Vector(0, 0, 0), App.Vector(10, 0, 0))
        circle = Draft.make_circle(3, placement=App.Placement(App.Vector(20, 0, 0), App.Rotation()), face=False)
        doc.recompute()
        Gui.Selection.clearSelection()
        for obj in (line, circle):
            Gui.Selection.addSelection(obj)
        return line, circle

    def transform_start(copy=False, world=False):
        Gui.runCommand("UniStation_Copy" if copy else "UniStation_Move")
        assert gui._session is not None, "Transform did not start"
        AF.setMode("rect")
        frame(world)
        wait()
        assert gui._session is not None, "Transform guard rejected the fixture"

    def move_local(doc):
        objects = transform_fixture(doc)
        initial = [App.Placement(o.Placement) for o in objects]
        doc.UndoMode = 1
        before = doc.UndoCount
        transform_start()
        enter((1, 2, 0))
        action("ConfirmPoint")
        enter((-4.5, 6.25, 2))
        assert gui._session.backend.ghost.whichChild.getValue() == -3
        assert all(o.Placement == p for o, p in zip(objects, initial))
        action("ConfirmPoint")
        assert gui._session is None and not AF.isActive() and len(doc.Objects) == 2
        delta = App.Vector(-4.5, 6.25, 2)
        equal([list(o.Placement.Base) for o in objects], [list(p.Base + delta) for p in initial])
        assert doc.UndoCount == before + 1
        doc.undo()
        equal([list(o.Placement.Base) for o in objects], [list(p.Base) for p in initial])
        doc.redo()
        equal([list(o.Placement.Base) for o in objects], [list(p.Base + delta) for p in initial])

    def copy_world(doc):
        objects = transform_fixture(doc)
        initial = [App.Placement(o.Placement) for o in objects]
        doc.UndoMode = 1
        before = doc.UndoCount
        transform_start(True, True)
        wire_points(((10, 20, 0), (15, 27, 3)))
        assert len(doc.Objects) == 4 and gui._session is None and not AF.isActive()
        assert all(o.Placement == p for o, p in zip(objects, initial))
        copies = [o for o in doc.Objects if o not in objects]
        assert all(hasattr(o, "Proxy") for o in copies)
        equal([list(o.Placement.Base) for o in copies],
              [list(p.Base + App.Vector(5, 7, 3)) for p in initial])
        assert doc.UndoCount == before + 1
        doc.undo()
        assert len(doc.Objects) == 2
        doc.redo()
        assert len(doc.Objects) == 4
        path = str(output_dir / "copy.FCStd")
        doc.saveAs(path)
        App.closeDocument(doc.Name)
        reopened = App.openDocument(path)
        assert len(reopened.Objects) == 4 and all(o.Shape.isValid() for o in reopened.Objects)

    def transform_plane(doc):
        objects = transform_fixture(doc)
        initial = [App.Vector(o.Placement.Base) for o in objects]
        wp = WorkingPlane.get_working_plane()
        wp.align_to_placement(App.Placement(App.Vector(3, 4, 25),
                                          App.Rotation(App.Vector(1, 0, 0), 30)))
        delta = 10*wp.u + 5*wp.v
        transform_start()
        wire_points(((0, 0, 0), (10, 5, 0)))
        equal([list(o.Placement.Base) for o in objects], [list(p+delta) for p in initial])

    def transform_cancel_pending(doc):
        objects = transform_fixture(doc)
        initial = [App.Placement(o.Placement) for o in objects]
        for copy in (False, True):
            transform_start(copy)
            enter((0, 0, 0))
            action("ConfirmPoint")
            action("FinishLine")
            assert gui._session is None and len(doc.Objects) == 2
            transform_start(copy)
            queue = []
            gui._session.backend.defer = queue.append
            wire_points(((0, 0, 0), (10, 0, 0)))
            assert len(queue) == 1 and gui._session.pending
            gui.cancel()
            queue[0]()
            assert all(o.Placement == p for o, p in zip(objects, initial))
            assert len(doc.Objects) == 2 and not AF.isActive()

    def transform_selection(doc):
        def rejected():
            try:
                gui.start("move")
            except RuntimeError:
                pass
            else:
                raise AssertionError("Unsupported selection was accepted")
            assert gui._session is None and not AF.isActive()
        Gui.Selection.clearSelection()
        rejected()
        objects = transform_fixture(doc)
        Gui.Selection.clearSelection()
        Gui.Selection.addSelection(objects[0], "Edge1")
        rejected()
        group = doc.addObject("App::DocumentObjectGroup", "TestGroup")
        group.addObject(objects[0])
        Gui.Selection.clearSelection()
        Gui.Selection.addSelection(objects[0])
        rejected()

