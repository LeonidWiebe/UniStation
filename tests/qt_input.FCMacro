    def check_circle(obj, center, radius, normal=App.Vector(0, 0, 1)):
        assert obj.Shape.isValid() and len(obj.Shape.Edges) == 1 and not obj.MakeFace
        curve = obj.Shape.Edges[0].Curve
        equal([list(curve.Center)], [list(center)])
        assert abs(curve.Radius - radius) < 1e-6, curve.Radius
        assert curve.Axis.cross(normal).Length < 1e-6
        assert abs(obj.Shape.Length - 2 * math.pi * radius) < 1e-6
        assert gui._session is None and not AF.isActive()

