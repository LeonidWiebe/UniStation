    def keyin_focus_probe(doc):
        import time

        def xyz(value):
            if value is None:
                return None
            try:
                return [float(value.x), float(value.y), float(value.z)]
            except AttributeError:
                return [float(value[0]), float(value[1]), float(value[2])]

        def axisflow_origin():
            try:
                origin = AF.getState()["origin"]
                return [float(origin[0]), float(origin[1]), float(origin[2])]
            except Exception as exc:
                return {"read_error": type(exc).__name__ + ": " + str(exc)}

        def describe(widget):
            if widget is None:
                return None
            try:
                return {
                    "class_name": str(widget.metaObject().className()),
                    "object_name": str(widget.objectName()),
                    "window_title": str(widget.windowTitle()),
                }
            except RuntimeError:
                return {"destroyed": True}

        def session_state():
            session = gui._session
            state = {"axisflow_origin": axisflow_origin()}
            try:
                state["axisflow_active"] = bool(AF.isActive())
            except Exception as exc:
                state["axisflow_active"] = {"read_error": type(exc).__name__}
            if session is None:
                state.update({"present": False, "type": None, "closed": None,
                              "first": None, "origin": None})
                return state
            try:
                state.update({
                    "present": True,
                    "type": type(session).__name__,
                    "closed": bool(session.closed),
                    "first": xyz(session.first),
                    "origin": xyz(session.origin),
                })
            except RuntimeError:
                state["read_error"] = "RuntimeError"
            return state

        def run_variant(name, starter, method):
            events = []
            phase = {"name": "start"}
            index = {"n": 0}
            started = time.monotonic()
            connected = {"value": False}
            widgets = {"edit": None, "error": None}
            application = QtWidgets.QApplication.instance()

            def clock():
                now = time.monotonic()
                return {"monotonic": now, "dt_ms": (now - started) * 1000.0}

            def on_focus(old, new):
                index["n"] += 1
                entry = {"n": index["n"], "phase": phase["name"]}
                entry.update(clock())
                try:
                    entry["old"] = describe(old)
                    entry["new"] = describe(new)
                    entry["active_window"] = describe(application.activeWindow())
                    entry["session"] = session_state()
                except Exception as exc:
                    entry["read_error"] = type(exc).__name__ + ": " + str(exc)
                events.append(entry)

            def snapshot(label):
                try:
                    focus = application.focusWidget()
                except RuntimeError:
                    focus = None
                try:
                    active = application.activeWindow()
                except RuntimeError:
                    active = None
                edit = widgets["edit"]
                error = widgets["error"]
                has_focus = None
                text = None
                error_text = None
                focus_is_edit = None
                try:
                    if edit is not None:
                        has_focus = bool(edit.hasFocus())
                        text = str(edit.text())
                        focus_is_edit = focus is edit
                except RuntimeError:
                    has_focus = None
                    text = None
                    focus_is_edit = None
                try:
                    if error is not None:
                        error_text = str(error.text())
                except RuntimeError:
                    error_text = None
                described = describe(focus)
                return {
                    "label": label,
                    "phase": phase["name"],
                    "focus": described,
                    "active_window": describe(active),
                    "edit_has_focus": has_focus,
                    "focus_is_edit": focus_is_edit,
                    "focus_object_name": described.get("object_name") if isinstance(described, dict) else None,
                    "text": text,
                    "error": error_text,
                    "session": session_state(),
                    "objects": [obj.Name for obj in doc.Objects],
                    "event_count": index["n"],
                    **clock(),
                }

            result = {
                "name": name,
                "method": method,
                "input_text": "abs 10;20;0",
                "observation_completed": False,
                "focus_contract_met": False,
            }
            try:
                starter()
                _, edit, apply, error = keyin_widgets()
                widgets["edit"] = edit
                widgets["error"] = error
                application.focusChanged.connect(on_focus)
                connected["value"] = True
                phase["name"] = "prepare"
                edit.window().activateWindow()
                wait()
                edit.setFocus()
                assert application.focusWidget() is edit, "Key-in field did not receive focus"
                phase["name"] = "typing"
                QTest.keyClicks(edit, "abs 10;20;0")
                phase["name"] = "before_confirm"
                before = snapshot("before_confirm")
                phase["name"] = "confirm"
                if method == "button":
                    QTest.mouseClick(apply, QtCore.Qt.LeftButton)
                elif method == "return":
                    QTest.keyClick(edit, QtCore.Qt.Key_Return)
                else:
                    raise ValueError("Unknown focus probe method: " + method)
                phase["name"] = "after_confirm"
                after = snapshot("after_confirm")
                samples = []
                for label in ("wait_100", "wait_200", "wait_300"):
                    phase["name"] = label
                    wait()
                    samples.append(snapshot(label))
                final = samples[-1]
                result.update({
                    "before_confirm": before,
                    "after_confirm": after,
                    "samples": samples,
                    "timeline": events,
                    "focus_contract_met": bool(final["focus_is_edit"])
                    and final["focus_object_name"] == "unistation_keyin",
                })
                accepted = after["session"]
                assert accepted["present"] and not accepted["closed"], accepted
                assert accepted["type"] in ("LineSession", "CircleSession"), accepted
                equal([accepted["first"]], [[10, 20, 0]])
                assert after["objects"] == [], after["objects"]
                assert final["session"]["present"] and not final["session"]["closed"], final["session"]
                equal([final["session"]["first"]], [[10, 20, 0]])
                assert final["objects"] == [], final["objects"]
                result["observation_completed"] = True
            finally:
                if connected["value"]:
                    application.focusChanged.disconnect(on_focus)
                    connected["value"] = False
                if gui._session is not None:
                    gui.cancel()
                phase["name"] = "after_cancel"
                result["after_cancel"] = snapshot("after_cancel")
                path = output_dir / "keyin-focus-probe.json"
                stored = []
                if path.exists():
                    stored = json.loads(path.read_text(encoding="utf-8"))
                stored.append(result)
                path.write_text(json.dumps(stored, indent=2), encoding="utf-8")
            return result

        variants = []
        for name, starter, method in (
                ("line_button", start, "button"),
                ("line_enter", start, "return"),
                ("circle_button", circle_start, "button"),
                ("circle_enter", circle_start, "return")):
            variant = run_variant(name, starter, method)
            assert variant["observation_completed"]
            assert gui._session is None
            assert not variant["after_cancel"]["session"]["present"]
            assert variant["after_cancel"]["objects"] == []
            variants.append(variant)
        return {
            "observation_completed": True,
            "focus_contract_met": all(item["focus_contract_met"] for item in variants),
            "circle_feature_claim": "not_claimed",
            "focus_contract_definition":
                "wait_300 focus_is_edit and focus object name unistation_keyin; measurement only",
            "variants": variants,
        }

    def wire_points(values=((0, 0, 0), (10, 0, 0), (0, 5, 0))):
        for value in values:
            enter(value)
            action("ConfirmPoint")

    def wire_button(name):
        button = gui._session.backend.panel.form.findChild(QtWidgets.QPushButton, name)
        assert button is not None
        QTest.mouseClick(button, QtCore.Qt.LeftButton)
        wait()

    def wire_open(doc):
        doc.UndoMode = 1
        wire_start()
        wire_points()
        assert not doc.Objects and len(gui._session.points) == 3
        assert gui._session.backend.lines.numVertices[0] >= 3
        action("FinishLine")
        assert gui._session is None and not AF.isActive()
        assert len(doc.Objects) == 1
        obj = doc.Objects[0]
        equal(points(obj), [[0, 0, 0], [10, 0, 0], [10, 5, 0]])
        assert not obj.Closed and not obj.MakeFace
        assert abs(obj.Shape.Length - 15) < 1e-6
        assert doc.UndoCount == 1
        doc.undo()
        assert not doc.Objects
        doc.redo()
        assert len(doc.Objects) == 1 and len(doc.Objects[0].Shape.Edges) == 2
        path = str(output_dir / "wire.FCStd")
        doc.saveAs(path)
        App.closeDocument(doc.Name)
        reopened = App.openDocument(path)
        assert len(reopened.Objects[0].Shape.Edges) == 2

