            Gui.activateWorkbench("UniStationWorkbench")
            start()
            Gui.activateWorkbench(name)
            wait()
            assert gui._session is None and not AF.isActive(), name
        Gui.activateWorkbench("UniStationWorkbench")

    def wire_start():
        Gui.runCommand("UniStation_Wire")
        AF.setMode("rect")
        frame(False)
        wait()

    def keyin_field():
        if gui._session is None:
            return None
        return gui._session.backend.panel.form.findChild(
            QtWidgets.QLineEdit, "unistation_keyin")

    def keyin_command_scope(doc):
        present = {}
        start()
        present["line"] = keyin_field() is not None
        assert present["line"]
        gui.cancel()
        wire_start()
        present["wire"] = keyin_field() is not None
        assert present["wire"]
        gui.cancel()
        circle_start()
        present["circle"] = keyin_field() is not None
        assert present["circle"]
        gui.cancel()
        arc_start(False)
        present["arc"] = keyin_field() is not None
        assert present["arc"] is False
        gui.cancel()
        objects = transform_fixture(doc)
        transform_start(False)
        present["move"] = keyin_field() is not None
        assert present["move"] is False
        gui.cancel()
        Gui.Selection.clearSelection()
        for obj in objects:
            Gui.Selection.addSelection(obj)
        transform_start(True)
        present["copy"] = keyin_field() is not None
        assert present["copy"] is False
        gui.cancel()
        Gui.Selection.clearSelection()
        return present

    def wire_preview_points():
        backend = gui._session.backend
        count = int(backend.lines.numVertices[0])
        values = backend.coords.point.getValues()
        return [[float(values[index][0]), float(values[index][1]), float(values[index][2])]
                for index in range(count)]

    def wire_keyin_relative_finish_undo(doc):
        doc.UndoMode = 1
        before = doc.UndoCount
        wire_start()
        keyin_submit("abs 10; 20; 0", "button")
        assert not doc.Objects and len(gui._session.points) == 1
        equal([list(gui._session.points[0])], [[10, 20, 0]])
        equal([list(gui._session.first)], [[10, 20, 0]])
        equal([list(AF.getState()["origin"])], [[10, 20, 0]])
        _, edit, _, error = keyin_widgets()
        assert edit.text() == "" and error.text() == ""
        keyin_submit("rel 5 cm; 0; 0")
        equal([list(point) for point in gui._session.points], [[10, 20, 0], [60, 20, 0]])
        equal([list(AF.getState()["origin"])], [[60, 20, 0]])
        assert edit.text() == "" and not doc.Objects
        keyin_submit("rel 0; 2 cm; 0")
        expected = [[10, 20, 0], [60, 20, 0], [60, 40, 0]]
        equal([list(point) for point in gui._session.points], expected)
        equal([list(gui._session.first)], [[10, 20, 0]])
        equal([list(AF.getState()["origin"])], [[60, 40, 0]])
        _, edit, _, error = keyin_widgets()
        assert edit.text() == "" and error.text() == ""
        assert not doc.Objects
        preview = wire_preview_points()
        equal(preview, expected)
        wire_button("unistation_finish_wire")
        assert gui._session is None and not AF.isActive()
        assert len(doc.Objects) == 1 and doc.UndoCount == before + 1
        obj = doc.Objects[0]
        assert not obj.Closed and not obj.MakeFace and len(obj.Shape.Edges) == 2
        vertices = points(obj)
        equal(vertices, expected)
        doc.undo()
        assert not doc.Objects
        doc.redo()
        assert len(doc.Objects) == 1
        redone = points(doc.Objects[0])
        equal(redone, vertices)
        return {"vertices": vertices, "preview": preview, "undo_before": before,
                "undo_after": before + 1, "redo": redone, "edges": 2, "face": False}

    def wire_keyin_reject_retry(doc):
        def state_copy():
            session = gui._session
            points = []
            if session is not None:
                points = [[float(point.x), float(point.y), float(point.z)]
                          for point in session.points]
            origin = AF.getState()["origin"]
            return {
                "points": points,
                "origin": [float(origin[0]), float(origin[1]), float(origin[2])],
                "objects": [obj.Name for obj in doc.Objects],
                "session": id(session) if session is not None else None,
            }

        def rejected(text, message):
            before = state_copy()
            keyin_submit(text)
            _, edit, _, error = keyin_widgets()
            after = state_copy()
            error_text = str(error.text())
            selected = str(edit.selectedText())
            assert error_text == message
            assert selected == text
            assert after["points"] == before["points"]
            assert after["origin"] == before["origin"]
            assert after["objects"] == before["objects"]
            assert after["session"] == before["session"] and after["session"] is not None
            return {"before": before, "after": after, "error": error_text, "selected": selected}

        wire_start()
        no_base = rejected(
            "rel 1; 0; 0",
            "Сначала задайте абсолютную точку или выберите точку мышью")
        bad_format = rejected(
            "abs 1; 2",
            "Нужно указать ровно три координаты через точку с запятой")
        keyin_submit("abs 10; 0; 0")
        _, edit, _, _ = keyin_widgets()
        assert len(gui._session.points) == 1 and edit.text() == ""
        duplicate = rejected("rel 0; 0; 0", "Choose a different next point.")
        keyin_submit("abs 20; 0; 0")
        assert len(gui._session.points) == 2
        early_close = rejected(
            "abs 10; 0; 0", "A closed contour needs at least three points.")
        keyin_submit("abs 20; 5; 0")
        _, edit, _, _ = keyin_widgets()
        assert len(gui._session.points) == 3 and not doc.Objects and edit.text() == ""
        wire_button("unistation_finish_wire")
        assert gui._session is None and len(doc.Objects) == 1
        vertices = points(doc.Objects[0])
        equal(vertices, [[10, 0, 0], [20, 0, 0], [20, 5, 0]])
        return {
            "no_base": no_base,
            "bad_format": bad_format,
            "duplicate": duplicate,
            "early_close": early_close,
            "vertices": vertices,
        }

    def wire_keyin_close(doc):
        def closed_wire(expected):
            assert gui._session is None and not AF.isActive()
            obj = doc.Objects[-1]
            assert obj.Closed and obj.Shape.isClosed() and not obj.MakeFace
            assert len(obj.Shape.Edges) == 3 and len(obj.Points) == 3
            vertices = points(obj)
            equal(vertices, expected)
            assert len({tuple(vertex) for vertex in vertices}) == 3
            return vertices

        wire_start()
        keyin_submit("abs 0; 0; 0")
        keyin_submit("abs 10; 0; 0")
        keyin_submit("abs 10; 5; 0")
        assert not doc.Objects and len(gui._session.points) == 3
        wire_button("unistation_close_contour")
        by_button = closed_wire([[0, 0, 0], [10, 0, 0], [10, 5, 0]])
        wire_start()
        keyin_submit("abs 0; 0; 0")
        keyin_submit("abs 20; 0; 0")
        keyin_submit("abs 20; 8; 0")
        assert len(doc.Objects) == 1 and len(gui._session.points) == 3
        keyin_submit("abs 0; 0; 0")
        by_text = closed_wire([[0, 0, 0], [20, 0, 0], [20, 8, 0]])
        assert len(doc.Objects) == 2
        return {"button": by_button, "text": by_text, "objects": 2}

